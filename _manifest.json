{
  "manifest_version": 2,
  "id": "local.live-dashboard",
  "version": "1.2.1",
  "name": "Live Dashboard 视奸面板（MaiBot 移植版）",
  "description": "实时设备状态、时间线、健康数据、服务状态和好友面板；可选每日主人日记、原生回复模型生成及按日期查询。非官方移植。",
  "author": {
    "name": "Pancakes-Labs（原作）；MaiBot 社区移植",
    "url": "https://github.com/Pancakes-Labs/astrbot_plugin_live_dashboard"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/hoangmaituan882-hue/maibot_plugin_live_dashboard"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9,<4.0"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.png",
      "fallback": "activity"
    }
  },
  "capabilities": [
    "send.text",
    "send.forward",
    "maisaka.reply.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
